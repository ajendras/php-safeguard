{
    "name": "php-safeguard/php-safeguard",
    "description": "Fast static security scanner for PHP and Laravel that finds OWASP issues, suggests fixes, and auto-hardens apps",
    "keywords": ["security", "scanner", "static-analysis", "sast", "owasp", "laravel", "vulnerability", "xss", "sqli"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "PHP Safeguard Contributors",
            "email": "maintainers@php-safeguard.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/console": "^6.4 || ^7.0",
        "nikic/php-parser": "^5.1",
        "guzzlehttp/guzzle": "^7.8",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "bin": [
        "bin/safeguard"
    ],
    "autoload": {
        "psr-4": {
            "PhpSafeguard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSafeguard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
